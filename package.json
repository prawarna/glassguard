{
  "name": "glassguard",
  "productName": "GlassGuard",
  "version": "0.1.0",
  "description": "Free, open-source system cleaner, live monitor, and heuristic security scanner for Windows with a glass UI.",
  "main": "main.js",
  "author": "GlassGuard contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "systeminformation": "^5.23.5"
  },
  "build": {
    "appId": "com.glassguard.app",
    "productName": "GlassGuard",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
